{
  "name": "ai-novel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bunx --bun next dev",
    "build": "bunx --bun next build && bun build --minify --outfile=.next/standalone/node_modules/@workflow/world-local/dist/index.js node_modules/@workflow/world-local/dist/index.js --target=bun",
    "start": "bunx --bun next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.2",
    "@codehz/auto-transition": "^0.0.3",
    "@workflow/world-local": "^4.0.1-beta.24",
    "ai": "^6.0.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "jsonriver": "^1.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "workflow": "^4.0.1-beta.40"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@toolwind/anchors": "^1.0.10",
    "@types/bun": "^1.3.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
